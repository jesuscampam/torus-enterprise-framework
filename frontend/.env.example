# Configuración del frontend TEAF.
#
# Solo las variables con prefijo VITE_ llegan al navegador, y TODAS son
# públicas: quedan incrustadas en el bundle y son legibles por cualquiera.
# NUNCA se pone aquí un secreto (ver docs/standards/SECURITY-STANDARD.md).

# Base de la API. Vacío = mismo origen (el caso de producción, con el frontend
# servido como estático detrás del backend). En desarrollo, el proxy de Vite
# redirige /api hacia http://localhost:8000.
VITE_API_BASE_URL=

# Prefijo de versión de la API — API-STANDARD.md §2.
VITE_API_VERSION=/api/v1

# Rutas de autenticación de la aplicación anfitriona. TEAF no expone endpoints
# de login (ADR-013): cada aplicación define los suyos y los declara aquí.
VITE_AUTH_LOGIN_PATH=/api/v1/auth/login
VITE_AUTH_REFRESH_PATH=/api/v1/auth/refresh
VITE_AUTH_LOGOUT_PATH=/api/v1/auth/logout
VITE_AUTH_ME_PATH=/api/v1/auth/me

# Timeout de cada petición, en milisegundos.
VITE_REQUEST_TIMEOUT_MS=30000

# Persistir los tokens en localStorage para que la sesión sobreviva a la
# recarga. Por defecto false: los tokens viven solo en memoria, que es lo
# resistente a XSS. Activarlo es una decisión consciente (ADR-013 §5).
VITE_PERSIST_SESSION=false

VITE_ENVIRONMENT=development
