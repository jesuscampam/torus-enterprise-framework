# ==========================================================================
# TEAF - TORUS Enterprise Application Framework
# .gitignore global del monorepo (backend + frontend + infra)
# ==========================================================================

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
pip-wheel-metadata/
instance/

# ---------- Node / React (frontend) ----------
node_modules/
dist/
build/
.vite/
.turbo/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- Docker ----------
*.pid

# ---------- Bases de datos locales ----------
*.sqlite3
*.db

# ---------- Logs ----------
*.log
logs/

# ---------- IDEs / Editores ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- Alembic (artefactos locales, no versiones) ----------
*.sqlite

# ---------- Terraform / IaC (si aplica en el futuro) ----------
*.tfstate
*.tfstate.backup
.terraform/
