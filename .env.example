# TEAF - Variables de entorno de ejemplo
# Copia este archivo a .env para desarrollo local. Nunca versiones .env real
# (ver .gitignore y docs/standards/SECURITY-STANDARD.md).

# Entorno: development | testing | staging | production
ENVIRONMENT=development

# Identidad de la aplicación
APP_NAME=TEAF

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Formato de log: console | json
LOG_FORMAT=console

# Ruta de archivo de log (opcional). Vacío = no escribir a archivo.
LOG_FILE=

# Host/puerto de escucha. Azure App Service y Render inyectan PORT en runtime.
HOST=0.0.0.0
PORT=8000
